    <connection>sco</connection>
    <sql>SELECT DISTINCT 
    CASE 
        WHEN ee.SPECIALITE_ESP_ET IN ('01', '02', '03', '04', '05', '06', '07', '08', '09') THEN ee.SPECIALITE_ESP_ET
        ELSE '10'
    END AS SPECIALITE_ESP_ET,
    ee.ID_ET,
    ee.ETAT,
    inscription.ANNEE_DEB
FROM 
    USER1.ESP_ETUDIANT ee
JOIN 
    USER1.ESP_INSCRIPTION inscription ON ee.ID_ET = inscription.ID_ET
WHERE 
    inscription.ANNEE_DEB = '2024'
ORDER BY 
    ee.ID_ET, 
    inscription.ANNEE_DEB
</sql>
