  <step>
    <name>Extraction depuis table Annee Universitaire</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>db_centrale</connection>
    <sql>SELECT 
    MAX(an.id_annee) AS id_annee, 
    an.annee_debut
FROM 
    public."annee_universitaire" an
GROUP BY 
    an.annee_debut
ORDER BY 
    id_annee, an.annee_debut;</sql>
