    <connection>sco</connection>
    <sql>SELECT insc.CODE_CL , insc.ANNEE_DEB , insc.ID_ET -- , etudiant.ETAT
    FROM USER1.ESP_INSCRIPTION  insc join  USER1.ESP_ETUDIANT  etudiant on etudiant.ID_ET = insc.ID_ET


 where ANNEE_DEB = '2024' and insc.CODE_CL not like '---'  --and etudiant.ETAT = 'A'

ORDER BY insc.ID_ET , insc.CODE_CL</sql>
