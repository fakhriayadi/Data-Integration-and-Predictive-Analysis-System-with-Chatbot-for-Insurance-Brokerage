  <step>
    <name>Extraction depuis table Categorie Classe</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sco</connection>
    <sql>SELECT ANNEE_DEB,
    CASE
        WHEN CODE_CL LIKE '4SE%' THEN '4SE'
        WHEN CODE_CL LIKE '3ALINFO%' THEN '3ALINFO'  -- Mettre cette condition avant '3A'
        WHEN CODE_CL LIKE '3A%' THEN '3A'
        WHEN CODE_CL LIKE '3GC%' THEN '3GC'
        WHEN CODE_CL LIKE '1GC%' THEN '1GC'
        WHEN CODE_CL LIKE '4IA%' THEN '4IA'
        WHEN CODE_CL LIKE '3EM%' THEN '3EM'
        WHEN CODE_CL LIKE '5MécaT%' THEN '5MécaT'
        WHEN CODE_CL LIKE '4OGI%' THEN '4OGI'
        WHEN CODE_CL LIKE '4GC%' THEN '4GC'
        WHEN CODE_CL LIKE '4DATA%' THEN '4DATA'
        WHEN CODE_CL LIKE '2P%' THEN '2P'
        WHEN CODE_CL LIKE '5SE%' THEN '5SE'
        WHEN CODE_CL LIKE '5INFINI%' THEN '5INFINI'
        WHEN CODE_CL LIKE '5ARCTIC%' THEN '5ARCTIC'
        WHEN CODE_CL LIKE '5NIDS%' THEN '5NIDS'
        WHEN CODE_CL LIKE '3IA%' THEN '3IA'
        WHEN CODE_CL LIKE '4SIM%' THEN '4SIM'
        WHEN CODE_CL LIKE '2ALEM%' THEN '2ALEM'
        WHEN CODE_CL LIKE '5SLEAM%' THEN '5SLEAM'
        WHEN CODE_CL LIKE '1EM%' THEN '1EM'
        WHEN CODE_CL LIKE '3B%' THEN '3B'
        WHEN CODE_CL LIKE '2ALINFO%' THEN '2ALINFO'
        WHEN CODE_CL LIKE '4NIDS%' THEN '4NIDS'
        WHEN CODE_CL LIKE '5DS%' THEN '5DS'
        WHEN CODE_CL LIKE '4IoSyS%' THEN '4IoSyS'
        WHEN CODE_CL LIKE '5OGI%' THEN '5OGI'
        WHEN CODE_CL LIKE '4MécaT%' THEN '4MécaT'
        WHEN CODE_CL LIKE '4 ERP-BI%' THEN '4 ERP-BI'
        WHEN CODE_CL LIKE '4DS%' THEN '4DS'
        WHEN CODE_CL LIKE '2ALSLEAM%' THEN '2ALSLEAM'
        WHEN CODE_CL LIKE '4TWIN%' THEN '4TWIN'
        WHEN CODE_CL LIKE '2MOBILITE%' THEN '2MOBILITE'
        WHEN CODE_CL LIKE '4 ARCTIC%' THEN '4 ARCTIC'
        WHEN CODE_CL LIKE '4SLEAM%' THEN '4SLEAM'
        WHEN CODE_CL LIKE '5ERP-BI%' THEN '5ERP-BI'
        WHEN CODE_CL LIKE '5IA%' THEN '5IA'
        WHEN CODE_CL LIKE '4ALINFO%' THEN '4ALINFO'
        WHEN CODE_CL LIKE '5SAE%' THEN '5SAE'
        WHEN CODE_CL LIKE '5WIN%' THEN '5WIN'
        WHEN CODE_CL LIKE '4SAE%' THEN '4SAE'
        WHEN CODE_CL LIKE '5TWIN%' THEN '5TWIN'
        WHEN CODE_CL LIKE '5GC%' THEN '5GC'
        WHEN CODE_CL LIKE '5GamiX%' THEN '5GamiX'
        WHEN CODE_CL LIKE '5IoSys%' THEN '5IoSys'
        WHEN CODE_CL LIKE '5SIM%' THEN '5SIM'
        WHEN CODE_CL LIKE '4GamiX%' THEN '4GamiX'
        WHEN CODE_CL LIKE '4INFINI%' THEN '4INFINI'
        WHEN CODE_CL LIKE '2A%' THEN '2A'
        WHEN CODE_CL LIKE '1ALINFO%' THEN '1ALINFO'
        WHEN CODE_CL LIKE '2EM%' THEN '2EM'
        WHEN CODE_CL LIKE '2GC%' THEN '2GC'
		WHEN CODE_CL LIKE '4WIN%' THEN '4WIN'
        ELSE '1A'
    END AS CODE_CL
FROM
    USER1.ESP_MODULE_PANIER_CLASSE_SAISO WHERE ANNEE_DEB = '2024'
GROUP BY
ANNEE_DEB,
    CASE
        WHEN CODE_CL LIKE '4SE%' THEN '4SE'
        WHEN CODE_CL LIKE '3ALINFO%' THEN '3ALINFO'
        WHEN CODE_CL LIKE '3A%' THEN '3A'
        WHEN CODE_CL LIKE '3GC%' THEN '3GC'
        WHEN CODE_CL LIKE '1GC%' THEN '1GC'
        WHEN CODE_CL LIKE '4IA%' THEN '4IA'
        WHEN CODE_CL LIKE '3EM%' THEN '3EM'
        WHEN CODE_CL LIKE '5MécaT%' THEN '5MécaT'
        WHEN CODE_CL LIKE '4OGI%' THEN '4OGI'
        WHEN CODE_CL LIKE '4GC%' THEN '4GC'
        WHEN CODE_CL LIKE '4DATA%' THEN '4DATA'
        WHEN CODE_CL LIKE '2P%' THEN '2P'
        WHEN CODE_CL LIKE '5SE%' THEN '5SE'
        WHEN CODE_CL LIKE '5INFINI%' THEN '5INFINI'
        WHEN CODE_CL LIKE '5ARCTIC%' THEN '5ARCTIC'
        WHEN CODE_CL LIKE '5NIDS%' THEN '5NIDS'
        WHEN CODE_CL LIKE '3IA%' THEN '3IA'
        WHEN CODE_CL LIKE '4SIM%' THEN '4SIM'
        WHEN CODE_CL LIKE '2ALEM%' THEN '2ALEM'
        WHEN CODE_CL LIKE '5SLEAM%' THEN '5SLEAM'
        WHEN CODE_CL LIKE '1EM%' THEN '1EM'
        WHEN CODE_CL LIKE '3B%' THEN '3B'
        WHEN CODE_CL LIKE '2ALINFO%' THEN '2ALINFO'
        WHEN CODE_CL LIKE '4NIDS%' THEN '4NIDS'
        WHEN CODE_CL LIKE '5DS%' THEN '5DS'
        WHEN CODE_CL LIKE '4IoSyS%' THEN '4IoSyS'
        WHEN CODE_CL LIKE '5OGI%' THEN '5OGI'
        WHEN CODE_CL LIKE '4MécaT%' THEN '4MécaT'
        WHEN CODE_CL LIKE '4 ERP-BI%' THEN '4 ERP-BI'
        WHEN CODE_CL LIKE '4DS%' THEN '4DS'
        WHEN CODE_CL LIKE '2ALSLEAM%' THEN '2ALSLEAM'
        WHEN CODE_CL LIKE '4TWIN%' THEN '4TWIN'
        WHEN CODE_CL LIKE '2MOBILITE%' THEN '2MOBILITE'
        WHEN CODE_CL LIKE '4 ARCTIC%' THEN '4 ARCTIC'
        WHEN CODE_CL LIKE '4SLEAM%' THEN '4SLEAM'
        WHEN CODE_CL LIKE '5ERP-BI%' THEN '5ERP-BI'
        WHEN CODE_CL LIKE '5IA%' THEN '5IA'
        WHEN CODE_CL LIKE '4ALINFO%' THEN '4ALINFO'
        WHEN CODE_CL LIKE '5SAE%' THEN '5SAE'
        WHEN CODE_CL LIKE '5WIN%' THEN '5WIN'
        WHEN CODE_CL LIKE '4SAE%' THEN '4SAE'
        WHEN CODE_CL LIKE '5TWIN%' THEN '5TWIN'
        WHEN CODE_CL LIKE '5GC%' THEN '5GC'
        WHEN CODE_CL LIKE '5GamiX%' THEN '5GamiX'
        WHEN CODE_CL LIKE '5IoSys%' THEN '5IoSys'
        WHEN CODE_CL LIKE '5SIM%' THEN '5SIM'
        WHEN CODE_CL LIKE '4GamiX%' THEN '4GamiX'
        WHEN CODE_CL LIKE '4INFINI%' THEN '4INFINI'
        WHEN CODE_CL LIKE '2A%' THEN '2A'
        WHEN CODE_CL LIKE '1ALINFO%' THEN '1ALINFO'
        WHEN CODE_CL LIKE '2EM%' THEN '2EM'
        WHEN CODE_CL LIKE '2GC%' THEN '2GC'
		WHEN CODE_CL LIKE '4WIN%' THEN '4WIN'
        ELSE '1A'
    END

ORDER BY
    CODE_CL</sql>
