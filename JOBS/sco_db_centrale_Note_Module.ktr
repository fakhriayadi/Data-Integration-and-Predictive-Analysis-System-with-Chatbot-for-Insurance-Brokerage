  <step>
    <name>Extraction depuis table NOTE 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sco</connection>
    <sql>SELECT
 note.ANNEE_DEB
,note.CODE_CL
,note.ID_ET
,note.CODE_MODULE
,entete.DESIGNATION_MODULE
,entete.COEF
,note.SEMESTRE
,note.ID_ENS
,note.NOTE_CC
,note.NOTE_TP
,note.NOTE_EXAM
,note.ABSENT_CC
,note.ABSENT_TP
,note.ABSENT_EXAM
,note.NOTE_RATRAP
,note.OBSERVATION
,entete.TYPE_SESSION


FROM USER1.ESP_NOTE note 

join ESP_ENTETE_NOTE entete on note.CODE_MODULE = entete.CODE_MODULE and note.ANNEE_DEB = entete.ANNEE_DEB and  note.CODE_CL = entete.CODE_CL and note.SEMESTRE = entete.SEMESTRE



where note.ANNEE_DEB = '2024'

order by note.CODE_CL











</sql>
