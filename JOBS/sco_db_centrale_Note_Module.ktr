    <name>Extraction depuis table NOTE</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sco</connection>
    <sql>SELECT
 note.ANNEE_DEB
,note.CODE_CL
,note.ID_ET
,panier.CODE_MODULE
,panier.DESIGNATION_NEW
,panier.COEF
,note.SEMESTRE
,note.ID_ENS
,note.NOTE_CC
,note.NOTE_TP
,note.NOTE_EXAM
,note.ABSENT_CC
,note.ABSENT_TP
,note.ABSENT_EXAM
,note.NOTE_RATRAP
,note.OBSERVATION
,entete.TYPE_SESSION
--,moyue.type_moy


--,note.TYPE_SESSION

--,moyue.TYPE_MOY
--,panier.DESIGNATION_NEW
--,panier.COEF

FROM USER1.ESP_NOTE note 

join ESP_ENTETE_NOTE entete on note.CODE_MODULE = entete.CODE_MODULE and note.ANNEE_DEB = entete.ANNEE_DEB and  note.CODE_CL = entete.CODE_CL and note.SEMESTRE = entete.SEMESTRE

join ESP_MODULE module on entete.CODE_MODULE = module.CODE_MODULE 


join ESP_MODULE_PANIER_CLASSE_SAISO panier on module.CODE_MODULE = panier.CODE_MODULE


--join ESP_ETUDIANT etudiant on note.ID_ET = etudiant.ID_ET 



--join USER1.ESP_MOY_UE_ETUDIANT moyue on etudiant.ID_ET = moyue.ID_ET 


where note.ANNEE_DEB = '2024'

order by note.CODE_CL


--join ESP_ETUDIANT etudiant on note.ID_ET = etudiant.ID_ET 



--join USER1.ESP_MOY_UE_ETUDIANT moyue on etudiant.ID_ET = moyue.ID_ET 











</sql>
