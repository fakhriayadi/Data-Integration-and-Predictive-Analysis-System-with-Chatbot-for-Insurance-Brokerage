    <connection>db_centrale</connection>
    <sql>select e.etudiant_id , e.id_user , ca.id_classe_annee_universitaire  , ca.id_annee  --, ce.id_classe_etudiant 

FROM public."etudiant" e join public."classe_etudiant" ce on e.etudiant_id = ce.etudiant_id


join public."classe_annee_universitaire" ca on ce.id_classe_annee_universitaire = ca.id_classe_annee_universitaire


order by e.etudiant_id 




</sql>
