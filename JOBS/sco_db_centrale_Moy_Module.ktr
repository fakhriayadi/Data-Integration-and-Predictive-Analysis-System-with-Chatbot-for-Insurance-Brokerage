    <sql>--select distinct moyue.CODE_UE , ue.ANNEE_DEB, moyue.ID_ET  ,moyue.NB_ECTS , moyue.TYPE_MOY ,  moyue.MOYENNE 


--FROM USER1.ESP_MOY_UE_ETUDIANT moyue join USER1.ESP_UE ue on moyue.CODE_UE  = ue.CODE_UE where  ue.ANNEE_DEB = '2024' 

--order by 	 moyue.CODE_UE , moyue.ID_ET


select 
distinct 
moyue.ANNEE_DEB
,moyue.ID_ET
,moymod.CODE_MODULE
,moymod.DESIGNATION_MODULE
,moymod.COEF
,ue.CODE_UE 
,moymod.TYPE_MOY
,moymod.MOYENNE 

--id_user , id_note_module  
 from USER1.ESP_MOY_MODULE_ETUDIANT moymod 

join USER1.ESP_MOY_PANIER_ETUDIANT moypanier 

on moymod.ANNEE_DEB = moypanier.ANNEE_DEB and moymod.ID_ET = moypanier.ID_ET and moymod.TYPE_MOY = moypanier.TYPE_MOY and moymod.NUM_PANIER = moypanier.NUM_PANIER

join USER1.ESP_ETUDIANT etudiant 

on moypanier.ET_ID_ET = etudiant.ID_ET  

join USER1.ESP_MOY_UE_ETUDIANT moyue

on  etudiant.ID_ET = moyue.ID_ET 

join  USER1.ESP_UE ue on moyue.CODE_UE  = ue.CODE_UE where  ue.ANNEE_DEB = '2024'

--where moyue.ANNEE_DEB = '2024'

</sql>
