    <sql>SELECT
entete.CODE_MODULE
,entete.CODE_CL
,entete.COEF
,entete.SEMESTRE
,entete.CONFIRMATION
,entete.ANNEE_DEB
,entete.DATE_CONFIRMATION
,entete.ID_ENS

---,ens.CODE_MAT

-- ajouter lkes jointure de ESP_ENSEIGNANT jusua ESP_ENTETE_NOTE pour la colonne id_employe (ens.CODE_MAT -- employe.matricule dans pgsys : EMP_CODE)


FROM USER1.ESP_ENTETE_NOTE entete 

order by entete.CODE_CL

--join USER1.ESP_NOTE note on entete.CODE_MODULE = note.CODE_MODULE and  entete.CODE_CL = note.CODE_CL and entete.ANNEE_DEB = note.ANNEE_DEB and entete.SEMESTRE = note.SEMESTRE  

--join USER1.ESP_ETUDIANT etudiant on note.ID_ET = etudiant.ID_ET  

--join USER1.ESP_INSCRIPTION inscription on etudiant.ID_ET = inscription.ID_ET


--join USER1.ESP_SAISON_CLASSE saison on inscription.ANNEE_DEB = saison.ANNEE_DEB and inscription.CODE_CL = saison.CODE_CL and inscription.SEMESTRE = saison.SEMESTRE


--join USER1.CLASSE classe on saison.CODE_CL = classe.CODE_CL



--join USER1.ESP_DEPT dept on classe.CODE_DEPT= dept.CODE_DEPT


--join USER1.ESP_ENSEIGNANT ens on dept.CODE_DEPT = ens.CODE_DEPT 


--where ens.CODE_MAT is not  null --and entete.ANNEE_DEB = '2024'  


--join ESP_MODULE module on note.CODE_MODULE =module.CODE_MODULE

--join ESP_MODULE_PANIER_CLASSE_SAISO panier on module.CODE_MODULE =panier.CODE_MODULE

--where entete.ANNEE_DEB = '2023'

</sql>
