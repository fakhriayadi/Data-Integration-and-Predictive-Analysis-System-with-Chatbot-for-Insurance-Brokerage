    <connection>db_centrale</connection>
    <sql>SELECT 
    distinct c.nom_classe , c.id_classe , s.id_semestre
FROM public."classe" c join public."classe_semestre" cs on c.id_classe = cs.id_classe 

join public."semestre" s on cs.id_semestre = s.id_semestre

order by c.nom_classe</sql>
