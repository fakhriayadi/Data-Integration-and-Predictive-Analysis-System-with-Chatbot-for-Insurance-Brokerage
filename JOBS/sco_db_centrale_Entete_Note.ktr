  <step>
    <name>Extraction depuis table Classe  2</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>db_centrale</connection>
    <sql>SELECT 
    distinct c.nom_classe , c.id_classe , planning.id_planning , m.id_module

FROM public."classe" c join public."classe_semestre" cs on c.id_classe = cs.id_classe 

join public."planning" planning on cs.id_classe_semestre = planning.id_classe_semestre
 
join public."unite" u on planning.id_annee = u.id_annee and planning.code_ue = u.code_ue  

join public."module" m on u.id_ue = m.id_ue 

order by c.nom_classe</sql>
