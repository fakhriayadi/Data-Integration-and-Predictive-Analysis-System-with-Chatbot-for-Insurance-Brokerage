    <connection>db_centrale</connection>
    <sql>SELECT 
    MAX(an.id_annee) AS id_annee, 
    an.annee_debut
FROM 
    public."annee_universitaire" an
GROUP BY 
    an.annee_debut
ORDER BY 
    id_annee, an.annee_debut;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
