 from USER1.ESP_MODULE_PANIER_CLASSE_SAISO panier join USER1.ESP_MODULE m  on m.CODE_MODULE = panier.CODE_MODULE

where m.ETAT = 'A' and panier.CODE_UE is not null and m.NB_HEURES is not null 

order by panier.CODE_MODULE , panier.CODE_UE
