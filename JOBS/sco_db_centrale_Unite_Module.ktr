    <connection>sco</connection>
    <sql>--SELECT  DISTINCT ue.CODE_UE,ue.LIB_UE, ue.NB_ECTS  , ue.NATURE_UE , ue.TYPE_UE   , empcs.ANNEE_DEB ,empcs.NB_HEURES

--FROM USER1.ESP_MODULE_PANIER_CLASSE_SAISO empcs 

--JOIN USER1.ESP_UE ue ON empcs.CODE_UE = ue.CODE_UE and empcs.ANNEE_DEB = ue.ANNEE_DEB 

--WHERE empcs.ANNEE_DEB = '2024' 
  
--AND ue.TYPE_UE IS NOT NULL 
 
--AND ue.NB_ECTS IS NOT NULL 

--order by ue.CODE_UE , ue.LIB_UE



SELECT DISTINCT 
    ue.CODE_UE,
    ue.LIB_UE,
    COALESCE(ue.NB_ECTS, 1.0) AS NB_ECTS,  -- Default to 1.0 if NULL
    ue.NATURE_UE,
    COALESCE(ue.TYPE_UE, 'N') AS TYPE_UE,  -- Default to 'N' if NULL
    COALESCE(ue.CHARGE_H, 0.0) AS CHARGE_H,
	ue.ANNEE_DEB
    --empcs.NB_HEURES
    --ue.CHARGE_H
FROM 
  --  USER1.ESP_MODULE_PANIER_CLASSE_SAISO empcs 
--JOIN 
    USER1.ESP_UE ue --ON empcs.CODE_UE = ue.CODE_UE AND empcs.ANNEE_DEB = ue.ANNEE_DEB 
WHERE 
    ue.ANNEE_DEB = '2024' --and ue.CHARGE_H is not null
ORDER BY 
    ue.CODE_UE, 
    ue.LIB_UE</sql>
