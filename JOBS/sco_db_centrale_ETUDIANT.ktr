    <sql>select  lower(TRIM(e.E_MAIL_ET)) AS E_MAIL_ET

, e.NOM_ET


, e.DATE_NAIS_ET


, e.NUM_CIN_PASSEPORT


, SUBSTR(e.TEL_ET, 1, 20) AS TEL_ET


, e.CODE_NATIONALITE


, e.SPECIALITE_ESP_ET


, e.DATE_DELIVRANCE


, e.LIEU_NAIS_ET

, e.SEXE 



, e.LIEU_DELIVRANCE




, e.PNOM_ET

, e.ID_ET



  FROM USER1.ESP_ETUDIANT e 
 
ORDER BY NLSSORT(E_MAIL_ET, 'NLS_SORT=BINARY')
</sql>
