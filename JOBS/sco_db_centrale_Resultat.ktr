  <step>
    <name>Extraction depuis table Classe Etudiant</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>db_centrale</connection>
    <sql>--SELECT c.nom_classe ,ce.id_classe_etudiant


--FROM public."classe" c 

--join public."classe_annee_universitaire" ca on c.id_classe = ca.id_classe


--join public."classe_etudiant" ce on ca.id_classe_annee_universitaire = ce.id_classe_annee_universitaire

--ORDER BY c.nom_classe ,ce.id_classe_etudiant



select moyue.etudiant_id , moyue.id_annee , moyue.id_session , ce.id_classe_etudiant 


from public."moy_unite" moyue

join public."classe_annee_universitaire" ca on moyue.id_classe_annee_universitaire = ca.id_classe_annee_universitaire


join public."classe_etudiant" ce on ca.id_classe_annee_universitaire = ce.id_classe_annee_universitaire


order by moyue.etudiant_id</sql>
