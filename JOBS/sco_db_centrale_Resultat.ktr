      <schema_name/>
    </partitioning>
    <connection>sco</connection>
    <sql>--SELECT ins.ID_ET , moyue.TYPE_MOY, ins.ANNEE_DEB , ins.CODE_CL


--FROM user1.ESP_ETUDIANT et 


--JOIN  

-- USER1.ESP_MOY_UE_ETUDIANT moyue --on et.ID_ET = moyue.ID_ET


--JOIN ESP_INSCRIPTION ins 



--ON et.ID_ET = ins.ID_ET


--where ins.ANNEE_DEB = '2024'

--order by  et.ID_ET , ins.ANNEE_DEB , ins.CODE_CL


--SELECT  distinct ins.ID_ET , moyue.TYPE_MOY, ins.ANNEE_DEB , ins.CODE_CL , ins.MOY_GENERAL
  

--FROM ESP_INSCRIPTION ins 


--JOIN USER1.ESP_ETUDIANT et on ins.ID_ET = et.ID_ET


--JOIN USER1.ESP_MOY_UE_ETUDIANT moyue on ins.ID_ET = moyue.ID_ET

--where ins.ANNEE_DEB = '2024' and ins.CODE_CL not like '---'

--order by  ins.ID_ET , ins.ANNEE_DEB , ins.CODE_CL



---Probleme 1A1 2ALINFO3 n'existe pas dans ESP_MODULE_PANIER_CLASSE_SAISO




SELECT  distinct et.ID_ET ,  ins.MOY_GENERAL   --, moyue.TYPE_MOY, ins.ANNEE_DEB , ins.MOY_GENERAL  --, ins.CODE_CL 
  

FROM ESP_INSCRIPTION ins 
--FROM USER1.ESP_ETUDIANT et 

join USER1.ESP_ETUDIANT et  on ins.ID_ET = et.ID_ET


--JOIN USER1.ESP_MOY_UE_ETUDIANT moyue on ins.ID_ET = moyue.ID_ET

where ins.ANNEE_DEB = '2024' --and ins.CODE_CL not like '---'

order by  et.ID_ET --, ins.ANNEE_DEB   --, ins.CODE_CL</sql>
