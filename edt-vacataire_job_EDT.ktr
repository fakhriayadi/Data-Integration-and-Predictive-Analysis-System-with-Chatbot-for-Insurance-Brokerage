  <step>
    <name>Extraction depuis table EDT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>edt</connection>
    <sql>SELECT emploi.CODEMPLOI, emploi.DATECOUR, emploi.CODESEANCE AS seance,   e.ID_ENS as id_ens, 
       module.CODE_MODULE,
       emploi.semestre as semestre, emploi.ANNEEDEB, classe.CODE_CL AS nom_classe,
       emploi.CODPLAN , panier.NB_HEURES

FROM USER2.EMPLOISEMAINE emploi
JOIN USER2.EMPSEM_MODULE emploim ON emploi.CODEMPLOI = emploim.CODEMPLOI
JOIN USER2.ESP_MODULE module ON module.CODE_MODULE = emploim.CODEMODULE
JOIN USER2.ESP_MODULE_PANIER_CLASSE_SAISO panier ON module.CODE_MODULE = panier.CODE_MODULE
JOIN USER2.EMPSEM_CLAS empmod ON emploi.CODEMPLOI = empmod.CODEMPLOI
JOIN USER2.CLASSE classe ON empmod.CODECL = classe.CODE_CL


JOIN USER2.EMPLOISEMENS empens ON emploi.CODEMPLOI = empens.CODEMPLOI
JOIN USER2.SYN_ESP_ENSEIGNANT e ON empens.IDENS = e.ID_ENS


WHERE emploi.ACTIF = '1'
  
      AND emploi.ANNEEDEB = 2024
 
      AND e.TYPE_ENS = 'V'

      AND emploi.DATECOUR BETWEEN '01/09/2024' AND '01/09/2025'  

      
        
ORDER BY emploi.CODEMPLOI ,emploi.CODPLAN, e.ID_ENS



</sql>
